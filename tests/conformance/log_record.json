  "field_rules": {
    "error.kind": "http_4xx | http_5xx | rate_limited | timeout | transport | parse | app",
    "id": "MUST be a UUIDv7 (version nibble 7). Request validation accepts any UUID string, but the database column is a UUIDv7 type and a v4 id fails on write: the record comes back in `rejected` with \"record could not be stored\". Generate v7 (48-bit unix milliseconds, then random) so records also sort by time.",
    "jsonb_safety": "every string (including keys inside context/metadata/params) must be valid UTF-8 with no NUL byte, and every integer must fit in 64 bits, or the record is rejected",
    "kind": "chat | text | embedding (defaults to chat)",
    "model": "the provider model string that was actually requested",
    "null_keys": "the SDK omits a TOP-LEVEL key whose value is null; nested nulls inside usage are sent as null and accepted",
    "provider": "openrouter | groq | openai | anthropic | google | other (unknown becomes other)",
    "required": [
      "id",
      "use_case",
      "model",
      "status",
      "started_at"
    ],
    "soft_references": "deployment_id, prompt_version_id and model_id must be a UUID or absent; they are not foreign keys, so a record survives the deletion of what it points at",
    "source": "remote | disk | bundle | manual",
    "started_at": "ISO8601 with an offset. Rejected when more than 5 minutes in the future or more than 7 days in the past - regenerate this field before replaying these fixtures against a live server",
    "status": "ok | error",
    "stop_kind": "stop | length | tool_call | content_filter | other; derived from finish_reason when absent",
    "usage.cost_source": "provider | catalog | unknown",
    "use_case": "the use case key, at most 512 bytes"
  },
