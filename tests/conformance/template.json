      "template": "{% capture x %}y{% endcapture %}"
    },
    {
      "expect": {
        "lint": "error",
        "reasons": [
          {
            "kind": "disallowed_tag",
            "value": "liquid"
          }
        ]
      },
      "name": "lint/liquid_tag",
      "template": "{% liquid assign x = 1 %}"
    },
    {
      "expect": {
        "lint": "error",
        "reasons": [
          {
            "kind": "whitespace_control",
            "value": "{%-"
          },
          {
            "kind": "whitespace_control",
            "value": "-%}"
          }
        ]
      },
      "name": "lint/whitespace_control_tag",
      "template": "{%- if a -%}x{%- endif -%}"
    },
    {
      "expect": {
        "lint": "error",
        "reasons": [
          {
            "kind": "whitespace_control",
            "value": "{{-"
          },
          {
            "kind": "whitespace_control",
            "value": "-}}"
          }
        ]
      },
      "name": "lint/whitespace_control_output",
      "template": "{{- a -}}"
    },
    {
      "expect": {
        "lint": "error",
        "reasons": [
          {
            "kind": "parse",
            "value": "Expected 'endif'"
          }
        ]
      },
      "name": "lint/parse_error",
      "template": "{% if a %}no end"
    }
  ],
  "variables_cases": [
    {
      "expect": {
        "variables": [
          "a",
          "b"
        ]
      },
      "name": "variables/output_positions",
      "template": "{{ a }} {{ b.c }}"
    },
    {
      "expect": {
        "variables": [
          "items"
        ]
      },
      "name": "variables/for_enumerable_only",
      "template": "{% for item in items %}{{ item }}{% endfor %}"
    },
    {
      "expect": {
        "variables": [
          "y"
        ]
      },
      "name": "variables/assign_target_excluded",
      "template": "{% assign x = y %}{{ x }}"
    },
    {
      "expect": {
        "variables": [
          "mode"
        ]
      },
      "name": "variables/condition_variables_included",
      "template": "{% if mode == \"a\" %}x{% endif %}"
    },
    {
      "expect": {
        "variables": [
          "xs"
        ]
      },
      "name": "variables/forloop_excluded",
      "template": "{% for i in xs %}{{ forloop.index }}{% endfor %}"
    }
  ]
}
